# Supabase - Public (Client & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase - Server Only (NEVER expose to client/browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# YouTube API (Optional, for YouTube Data API v3 metadata)
YOUTUBE_API_KEY=your-youtube-api-key

# LRCLIB Lyrics API (Default: https://lrclib.net/api)
LRCLIB_API_URL=https://lrclib.net/api

# Spotify API (Server only, for public playlist import)
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# Upstash Redis (Optional, for caching stream URLs and rate limiting)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token
