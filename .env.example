# Supabase - public (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase - server only (NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# YouTube API (optional, for YouTube Data API v3)
YOUTUBE_API_KEY=your-youtube-api-key

# LRCLIB lyrics API base URL
LRCLIB_API_URL=https://lrclib.net/api

# App URL (used for OAuth callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Spotify Client Credentials (server-only, for public playlist import without user login)
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
